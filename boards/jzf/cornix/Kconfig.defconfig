# cornix board configuration

# Copyright (c) 2020 The ZMK Contributors
# SPDX-License-Identifier: MIT

## Cornix left: split peripheral of the Cornix right central
if BOARD_CORNIX_LEFT

config ZMK_SPLIT
	default y

config ZMK_BLE
	default y

config ZMK_SPLIT_ROLE_CENTRAL
    default n

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default n

config BOARD_CORNIX_CHARGER
    default y

# Add keyboard debouncing
config ZMK_KSCAN_DEBOUNCE_PRESS_MS
    default 3
config ZMK_KSCAN_DEBOUNCE_RELEASE_MS
    default 3

## disable rgb by default
config ZMK_RGB_UNDERGLOW
	default n
config ZMK_RGB_UNDERGLOW_EXT_POWER
	default n

endif # BOARD_CORNIX_LEFT

# TB split topology: the left half advertises its own name.
if BOARD_CORNIX_LEFT && SHIELD_CORNIX_TB_PERIPHERAL

config ZMK_KEYBOARD_NAME
	default "Crorb_left"

endif # BOARD_CORNIX_LEFT && SHIELD_CORNIX_TB_PERIPHERAL

# Cornix right = split central that owns the host link (BLE + USB). Every right
# image (normal and settings_reset) uses these defaults; the shield .conf adds
# the rest (peripheral count, Studio, tuning).
if BOARD_CORNIX_RIGHT
config ZMK_KEYBOARD_NAME
    default "Crorb"
config ZMK_SPLIT
    default y
config ZMK_SPLIT_ROLE_CENTRAL
    default y
config ZMK_BLE
    default y
config USB_NRFX
    default y if USB
config USB_DEVICE_STACK
    default y if USB
config BT_MAX_CONN
    default 7 if ZMK_BLE
config BT_MAX_PAIRED
    default 7 if ZMK_BLE
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y if ZMK_SPLIT_BLE
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y if ZMK_SPLIT_BLE
config ZMK_STUDIO
    default y if !SHIELD_SETTINGS_RESET
endif # BOARD_CORNIX_RIGHT
