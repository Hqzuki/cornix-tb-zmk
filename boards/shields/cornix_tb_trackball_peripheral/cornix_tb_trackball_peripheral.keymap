/* SPDX-License-Identifier: MIT
 * The XIAO trackball is a split peripheral without keys. The central owns the
 * real keymap (config/Cornix_tb.keymap); this empty one only satisfies the
 * peripheral image (same placeholder as the board's cornix.keymap).
 */
#include <behaviors.dtsi>
/ {
    keymap {
        compatible = "zmk,keymap";
        peripheral {
            bindings = <
&none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none
            >;
        };
    };
};
