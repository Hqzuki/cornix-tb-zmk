config CORNIX_LED_STATUS
    bool "Shared Cornix LED status"
    default y if SHIELD_CORNIX_INDICATOR || CORNIX_TB_TRACKBALL
    depends on ZMK_BLE

config CORNIX_KEYMAP
    bool "Cornix keymap support"
    default y if CORNIX_RIGHT_CENTRAL && ZMK_BLE

config CORNIX_PAW3222
    bool "PAW3222 three-wire GPIO driver"
    default y if DT_HAS_CORNIX_PAW3222_GPIO_ENABLED
    depends on GPIO && INPUT

config CORNIX_PAW3222_PROBE_ATTEMPTS
    int "Sensor probe attempts (2 s apart) before polling stops"
    depends on CORNIX_PAW3222
    range 1 100
    default 5

# Role symbols. Exactly one of these is set per normal image; the settings_reset
# images set none of them. Topology: the Cornix RIGHT half is the split central
# (host BLE/USB, keymap, Studio, pointer pipeline); the Cornix LEFT half and the
# XIAO trackball are its two peripherals.
config CORNIX_RIGHT_CENTRAL
    bool "Cornix right half as split central (keymap, host link, pointer pipeline)"
    default y if SHIELD_CORNIX_TB_RIGHT_CENTRAL

config CORNIX_LEFT_PERIPHERAL
    bool "Cornix left half as a peripheral of the right central (outer LED = layer)"
    default y if SHIELD_CORNIX_TB_PERIPHERAL && BOARD_CORNIX_LEFT

config CORNIX_TB_TRACKBALL
    bool "XIAO trackball peripheral (forwards pointer events, local-only RGB LED)"
    default y if SHIELD_CORNIX_TB_TRACKBALL_PERIPHERAL

config CORNIX_AUTO_OS
    bool "Detect Bluetooth host layout automatically"
    default y if CORNIX_KEYMAP && ZMK_SPLIT_ROLE_CENTRAL && !SHIELD_SETTINGS_RESET
    depends on ZMK_BLE && ZMK_SPLIT_ROLE_CENTRAL
    select BT_GATT_AUTHORIZATION_CUSTOM

config CORNIX_AUTO_OS_SETTLE_MS
    int "Wait after new Bluetooth fingerprint evidence (ms)"
    depends on CORNIX_AUTO_OS
    range 500 5000
    default 1000
